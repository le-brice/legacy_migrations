<?xml version="1.0" encoding="UTF-8"?>
<talendJobExport>
  <jobName>job_customer_dedup_and_clean</jobName>
  <jobType>tMap_single_pass</jobType>
  <purpose>Replicate the customer dedupe and clean portion of the legacy stored procedure.</purpose>
  <source>
    <table connection="snowflake">dbt_blepoutre_RAW.customers</table>
  </source>
  <target>
    <table connection="snowflake">DBT_SANDBOX_BRICE.LEGACY_PROD.customer_clean</table>
    <writeMode>create_or_replace</writeMode>
  </target>
  <components>
    <component name="tSnowflakeInput_1" type="tSnowflakeInput">
      <sql><![CDATA[
select
  customer_id,
  customer_natural_key,
  first_name,
  last_name,
  email,
  phone,
  country_code,
  created_at,
  marketing_opt_in,
  loyalty_tier,
  lifetime_value
from dbt_blepoutre_RAW.customers
      ]]></sql>
    </component>
    <component name="tMap_1" type="tMap">
      <description>Normalize names, email, phone, loyalty tier, lifetime value, customer segment, and dedupe key.</description>
      <expressions>
        <expression outputColumn="first_name_clean"><![CDATA[TalendString.initCap(StringHandling.TRIM(row1.first_name))]]></expression>
        <expression outputColumn="last_name_clean"><![CDATA[TalendString.initCap(StringHandling.TRIM(row1.last_name))]]></expression>
        <expression outputColumn="full_name_clean"><![CDATA[(StringHandling.TRIM(row1.first_name) != null && StringHandling.TRIM(row1.last_name) != null) ? TalendString.initCap(StringHandling.TRIM(row1.first_name)) + " " + TalendString.initCap(StringHandling.TRIM(row1.last_name)) : null]]></expression>
        <expression outputColumn="email_clean"><![CDATA[row1.email == null ? null : StringHandling.LOWER(StringHandling.TRIM(row1.email))]]></expression>
        <expression outputColumn="phone_clean"><![CDATA[row1.phone == null ? null : StringHandling.TRIM(row1.phone)]]></expression>
        <expression outputColumn="country_code_clean"><![CDATA[row1.country_code == null ? null : StringHandling.UPCASE(StringHandling.TRIM(row1.country_code))]]></expression>
        <expression outputColumn="loyalty_tier_clean"><![CDATA[(row1.loyalty_tier == null || StringHandling.TRIM(row1.loyalty_tier).equals("")) ? "bronze" : StringHandling.LOWER(StringHandling.TRIM(row1.loyalty_tier))]]></expression>
        <expression outputColumn="lifetime_value_clean"><![CDATA[row1.lifetime_value == null ? 0 : row1.lifetime_value]]></expression>
        <expression outputColumn="customer_segment"><![CDATA[(row1.lifetime_value == null ? 0 : row1.lifetime_value) >= 1000 ? "vip" : ((row1.lifetime_value == null ? 0 : row1.lifetime_value) >= 300 ? "growth" : "standard")]]></expression>
        <expression outputColumn="dedupe_key"><![CDATA[(row1.email != null && !StringHandling.TRIM(row1.email).equals("")) ? StringHandling.LOWER(StringHandling.TRIM(row1.email)) : TalendString.getAsciiRandomString(0)]]></expression>
        <expression outputColumn="dedupe_fallback_note"><![CDATA[(row1.email != null && !StringHandling.TRIM(row1.email).equals("")) ? "email_key" : "fallback_to_soundex_in_sql" ]]></expression>
      </expressions>
    </component>
    <component name="tSnowflakeRow_1" type="tSnowflakeRow">
      <description>Use SQL window logic to exactly match stored procedure ranking and duplicate counting.</description>
      <sql><![CDATA[
create schema if not exists DBT_SANDBOX_BRICE.LEGACY_PROD;

create or replace table DBT_SANDBOX_BRICE.LEGACY_PROD.customer_clean as
with normalized as (
    select
        customer_id,
        customer_natural_key,
        initcap(trim(first_name)) as first_name_clean,
        initcap(trim(last_name)) as last_name_clean,
        case
            when trim(first_name) is not null and trim(last_name) is not null
                then initcap(trim(first_name)) || ' ' || initcap(trim(last_name))
            else null
        end as full_name_clean,
        lower(trim(email)) as email_clean,
        trim(phone) as phone_clean,
        upper(trim(country_code)) as country_code,
        created_at,
        marketing_opt_in,
        coalesce(nullif(lower(trim(loyalty_tier)), ''), 'bronze') as loyalty_tier_clean,
        coalesce(lifetime_value, 0) as lifetime_value,
        case
            when coalesce(lifetime_value, 0) >= 1000 then 'vip'
            when coalesce(lifetime_value, 0) >= 300 then 'growth'
            else 'standard'
        end as customer_segment,
        case
            when nullif(lower(trim(email)), '') is not null then lower(trim(email))
            else soundex(initcap(trim(first_name))) || '_' || soundex(initcap(trim(last_name)))
        end as dedupe_key
    from dbt_blepoutre_RAW.customers
), ranked as (
    select
        *,
        count(*) over (partition by dedupe_key) as duplicate_record_count,
        row_number() over (
            partition by dedupe_key
            order by lifetime_value desc, created_at asc, customer_id asc
        ) as dedupe_rank
    from normalized
)
select
    customer_id as canonical_customer_id,
    customer_natural_key,
    first_name_clean,
    last_name_clean,
    full_name_clean,
    email_clean,
    phone_clean,
    country_code,
    created_at,
    marketing_opt_in,
    loyalty_tier_clean,
    lifetime_value,
    customer_segment,
    duplicate_record_count
from ranked
where dedupe_rank = 1
;
      ]]></sql>
    </component>
  </components>
  <finalLegacyProdTable>DBT_SANDBOX_BRICE.LEGACY_PROD.customer_clean</finalLegacyProdTable>
</talendJobExport>
