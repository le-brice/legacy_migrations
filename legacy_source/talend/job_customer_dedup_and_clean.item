<?xml version="1.0" encoding="UTF-8"?>
<talendJobExport>
  <jobName>job_customer_dedup_and_clean</jobName>
  <jobType>governed_component_graph</jobType>
  <purpose>Replicate the customer dedupe and clean portion of the legacy stored procedure as a declarative Talend component graph that can be migrated into dbt models, tests, and contracts.</purpose>
  <migrationConvention>
    <targetPattern>Represent each Talend component as a dbt model, macro, snapshot, or seed-backed lookup rather than embedding warehouse SQL in the job export.</targetPattern>
    <sqlPolicy>Do not embed SQL statements in Talend job components. Express business logic as component metadata, expressions, filters, joins, ranking rules, and output mappings.</sqlPolicy>
    <parityPolicy>The component graph must preserve the same transformation logic and target grain described by the legacy stored procedure specification.</parityPolicy>
  </migrationConvention>
  <source>
    <table connection="snowflake">dbt_blepoutre_RAW.customers</table>
  </source>
  <target>
    <table connection="snowflake">DBT_SANDBOX_BRICE.LEGACY_PROD.customer_clean</table>
    <writeMode>create_or_replace</writeMode>
    <targetGrain>one row per deduplicated logical customer</targetGrain>
  </target>
  <components>
    <component name="tSnowflakeInput_customers" type="tSnowflakeInput">
      <description>Read raw customer records from Snowflake.</description>
      <readTarget connection="snowflake">dbt_blepoutre_RAW.customers</readTarget>
      <selectedColumns>
        <column>customer_id</column>
        <column>customer_natural_key</column>
        <column>first_name</column>
        <column>last_name</column>
        <column>email</column>
        <column>phone</column>
        <column>country_code</column>
        <column>created_at</column>
        <column>marketing_opt_in</column>
        <column>loyalty_tier</column>
        <column>lifetime_value</column>
      </selectedColumns>
    </component>
    <component name="tMap_normalize_customer_fields" type="tMap">
      <description>Normalize names, contact fields, country, loyalty tier, lifetime value, customer segment, and dedupe key.</description>
      <expressions>
        <expression outputColumn="first_name_clean"><![CDATA[TalendString.initCap(StringHandling.TRIM(row1.first_name))]]></expression>
        <expression outputColumn="last_name_clean"><![CDATA[TalendString.initCap(StringHandling.TRIM(row1.last_name))]]></expression>
        <expression outputColumn="full_name_clean"><![CDATA[(StringHandling.TRIM(row1.first_name) != null && StringHandling.TRIM(row1.last_name) != null) ? TalendString.initCap(StringHandling.TRIM(row1.first_name)) + " " + TalendString.initCap(StringHandling.TRIM(row1.last_name)) : null]]></expression>
        <expression outputColumn="email_clean"><![CDATA[row1.email == null ? null : StringHandling.LOWER(StringHandling.TRIM(row1.email))]]></expression>
        <expression outputColumn="phone_clean"><![CDATA[row1.phone == null ? null : StringHandling.TRIM(row1.phone)]]></expression>
        <expression outputColumn="country_code_clean"><![CDATA[row1.country_code == null ? null : StringHandling.UPCASE(StringHandling.TRIM(row1.country_code))]]></expression>
        <expression outputColumn="loyalty_tier_clean"><![CDATA[(row1.loyalty_tier == null || StringHandling.TRIM(row1.loyalty_tier).equals("")) ? "bronze" : StringHandling.LOWER(StringHandling.TRIM(row1.loyalty_tier))]]></expression>
        <expression outputColumn="lifetime_value_clean"><![CDATA[row1.lifetime_value == null ? 0 : row1.lifetime_value]]></expression>
        <expression outputColumn="customer_segment"><![CDATA[(row1.lifetime_value == null ? 0 : row1.lifetime_value) >= 1000 ? "vip" : ((row1.lifetime_value == null ? 0 : row1.lifetime_value) >= 300 ? "growth" : "standard")]]></expression>
        <expression outputColumn="email_present_flag"><![CDATA[row1.email != null && !StringHandling.TRIM(row1.email).equals("")]]></expression>
        <expression outputColumn="dedupe_key"><![CDATA[(row1.email != null && !StringHandling.TRIM(row1.email).equals("")) ? StringHandling.LOWER(StringHandling.TRIM(row1.email)) : Soundex.soundex(TalendString.initCap(StringHandling.TRIM(row1.first_name))) + "_" + Soundex.soundex(TalendString.initCap(StringHandling.TRIM(row1.last_name)))]]></expression>
      </expressions>
    </component>
    <component name="tAggregateRow_duplicate_record_count" type="tAggregateRow">
      <description>Count raw records in each dedupe group.</description>
      <groupBy>
        <column>dedupe_key</column>
      </groupBy>
      <operations>
        <operation outputColumn="duplicate_record_count" function="count">customer_id</operation>
      </operations>
    </component>
    <component name="tSortRow_dedupe_priority" type="tSortRow">
      <description>Order rows inside each dedupe key by survivor priority.</description>
      <sortKeys>
        <sortKey column="dedupe_key" order="asc" />
        <sortKey column="lifetime_value_clean" order="desc" nulls="last" />
        <sortKey column="created_at" order="asc" />
        <sortKey column="customer_id" order="asc" />
      </sortKeys>
    </component>
    <component name="tUniqRow_keep_canonical_customer" type="tUniqRow">
      <description>Keep the first row per dedupe key after sorting to reproduce stored procedure survivor selection.</description>
      <keyColumns>
        <column>dedupe_key</column>
      </keyColumns>
      <keepMode>first</keepMode>
    </component>
    <component name="tMap_finalize_customer_clean" type="tMap">
      <description>Map canonical output columns and preserve transformed customer attributes.</description>
      <expressions>
        <expression outputColumn="canonical_customer_id"><![CDATA[row_survivor.customer_id]]></expression>
        <expression outputColumn="customer_natural_key"><![CDATA[row_survivor.customer_natural_key]]></expression>
        <expression outputColumn="first_name_clean"><![CDATA[row_survivor.first_name_clean]]></expression>
        <expression outputColumn="last_name_clean"><![CDATA[row_survivor.last_name_clean]]></expression>
        <expression outputColumn="full_name_clean"><![CDATA[row_survivor.full_name_clean]]></expression>
        <expression outputColumn="email_clean"><![CDATA[row_survivor.email_clean]]></expression>
        <expression outputColumn="phone_clean"><![CDATA[row_survivor.phone_clean]]></expression>
        <expression outputColumn="country_code"><![CDATA[row_survivor.country_code_clean]]></expression>
        <expression outputColumn="created_at"><![CDATA[row_survivor.created_at]]></expression>
        <expression outputColumn="marketing_opt_in"><![CDATA[row_survivor.marketing_opt_in]]></expression>
        <expression outputColumn="loyalty_tier_clean"><![CDATA[row_survivor.loyalty_tier_clean]]></expression>
        <expression outputColumn="lifetime_value"><![CDATA[row_survivor.lifetime_value_clean]]></expression>
        <expression outputColumn="customer_segment"><![CDATA[row_survivor.customer_segment]]></expression>
        <expression outputColumn="duplicate_record_count"><![CDATA[row_counts.duplicate_record_count]]></expression>
      </expressions>
    </component>
    <component name="tSnowflakeOutput_customer_clean" type="tSnowflakeOutput">
      <description>Replace the legacy production-style customer clean table with the canonical deduplicated output.</description>
      <writeTarget connection="snowflake">DBT_SANDBOX_BRICE.LEGACY_PROD.customer_clean</writeTarget>
      <writeMode>create_or_replace</writeMode>
    </component>
  </components>
  <connections>
    <connection from="tSnowflakeInput_customers" to="tMap_normalize_customer_fields" type="FLOW_MAIN" />
    <connection from="tMap_normalize_customer_fields" to="tAggregateRow_duplicate_record_count" type="FLOW_MAIN" />
    <connection from="tMap_normalize_customer_fields" to="tSortRow_dedupe_priority" type="FLOW_MAIN" />
    <connection from="tSortRow_dedupe_priority" to="tUniqRow_keep_canonical_customer" type="FLOW_MAIN" />
    <connection from="tUniqRow_keep_canonical_customer" to="tMap_finalize_customer_clean" type="FLOW_MAIN" />
    <connection from="tAggregateRow_duplicate_record_count" to="tMap_finalize_customer_clean" type="FLOW_LOOKUP" lookupKey="dedupe_key" />
    <connection from="tMap_finalize_customer_clean" to="tSnowflakeOutput_customer_clean" type="FLOW_MAIN" />
  </connections>
  <dbtProjection>
    <stagingModels>
      <model>stg_customers</model>
    </stagingModels>
    <intermediateModels>
      <model>int_customer_normalized</model>
      <model>int_customer_duplicate_counts</model>
      <model>int_customer_dedupe_ranked</model>
    </intermediateModels>
    <martModels>
      <model>customer_clean</model>
    </martModels>
    <recommendedTests>
      <test>not_null on canonical_customer_id</test>
      <test>unique on canonical_customer_id</test>
      <test>accepted_values on customer_segment</test>
      <test>not_null on duplicate_record_count</test>
    </recommendedTests>
  </dbtProjection>
  <finalLegacyProdTable>DBT_SANDBOX_BRICE.LEGACY_PROD.customer_clean</finalLegacyProdTable>
</talendJobExport>
